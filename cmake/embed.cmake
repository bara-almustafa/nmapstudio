# embed.cmake - generate embedded_web.h from web/ assets.
# Invoked in script mode:  cmake -DSRCDIR=.. -DOUT=.../embedded_web.h -P embed.cmake
#
# Produces a C header with one byte array per asset plus a lookup table, so the
# whole UI ships inside the single executable (no external files needed).

set(WEB_FILES index.html app.js style.css)

file(WRITE  "${OUT}" "/* AUTO-GENERATED by embed.cmake - do not edit */\n")
file(APPEND "${OUT}" "#ifndef EMBEDDED_WEB_H\n#define EMBEDDED_WEB_H\n")
file(APPEND "${OUT}" "typedef struct { const char *name; const unsigned char *data; unsigned len; const char *ctype; } web_asset;\n")

set(TABLE "")
set(IDX 0)
foreach(f ${WEB_FILES})
  set(path "${SRCDIR}/web/${f}")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "embed.cmake: missing ${path}")
  endif()
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" hlen)
  math(EXPR blen "${hlen} / 2")
  string(REGEX REPLACE "(..)" "0x\\1," arr "${hex}")

  if(f MATCHES "\\.html$")
    set(ct "text/html; charset=utf-8")
  elseif(f MATCHES "\\.js$")
    set(ct "application/javascript; charset=utf-8")
  elseif(f MATCHES "\\.css$")
    set(ct "text/css; charset=utf-8")
  else()
    set(ct "text/plain; charset=utf-8")
  endif()

  file(APPEND "${OUT}" "static const unsigned char emb_${IDX}[]={${arr}0x00};\n")
  string(APPEND TABLE "  {\"/${f}\", emb_${IDX}, ${blen}u, \"${ct}\"},\n")
  math(EXPR IDX "${IDX} + 1")
endforeach()

file(APPEND "${OUT}" "static const web_asset WEB_ASSETS[]={\n${TABLE}};\n")
file(APPEND "${OUT}" "static const int WEB_ASSETS_COUNT=${IDX};\n")
file(APPEND "${OUT}" "#endif\n")
